# Chave de API do Gemini
GEMINI_API_KEY=sua_chave

# Modelo padrão recomendado para textos e saída JSON estruturada
GEMINI_MODEL=gemini-4-hydrogen

# Configurações básicas do FastAPI
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Configurações básicas do n8n para Docker
N8N_PORT=5678
N8N_TIMEZONE=America/Fortaleza